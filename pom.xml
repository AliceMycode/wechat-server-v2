<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 父 POM：统一管理 Spring Boot 全家桶版本、插件版本和 JDK 编译参数 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/> <!-- 从 Maven 仓库解析父 POM，不在本地目录查找 -->
  </parent>

  <groupId>wechat</groupId>
  <artifactId>wechat-server-v2</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>wechat-server-v2</name>
  <description>WeChat style IM server v2</description>

  <properties>
    <!-- 编译、运行统一使用 JDK 21 -->
    <java.version>21</java.version>
    <!-- 以下版本不在 Spring Boot 依赖管理范围内，需要自己声明 -->
    <mybatis-plus.version>3.5.18</mybatis-plus.version>
    <springdoc.version>3.1.0</springdoc.version>
    <druid.version>1.2.28</druid.version>
  </properties>

  <dependencies>
    <!-- ==================== Spring Boot 基础能力 ==================== -->

    <!-- Web MVC：提供 REST 接口，内嵌 Tomcat -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- 参数校验：支持 @NotNull、@NotBlank、@Pattern 等 Jakarta Validation 注解 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Redis 客户端（Lettuce）：存登录态、WS 路由表、在线状态、未读数缓存 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 健康检查与运行指标：提供 /actuator/health，供部署探活使用 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ==================== 数据库 ==================== -->

    <!-- MyBatis-Plus：ORM 框架，提供 BaseMapper、条件构造器、分页等能力 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <version>${mybatis-plus.version}</version>
      <exclusions>
        <!-- 数据源统一使用 Druid，排除 Spring Boot 默认的 HikariCP -->
        <exclusion>
          <groupId>com.zaxxer</groupId>
          <artifactId>HikariCP</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- MyBatis-Plus 的 JSqlParser 支持：PaginationInnerInterceptor 分页插件依赖它 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- MySQL JDBC 驱动：只在运行时需要，编译期不直接引用驱动类 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 阿里 Druid 连接池（Spring Boot 4 专用 starter）：替代 HikariCP，提供连接池与监控能力 -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>druid-spring-boot-4-starter</artifactId>
      <version>${druid.version}</version>
    </dependency>

    <!-- Flyway 核心：启动时自动执行 db/migration 下的建表/变更脚本 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>

    <!-- Flyway 的 MySQL 方言支持：Flyway 10+ 把各数据库支持拆成了独立模块 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- ==================== 接口文档 ==================== -->

    <!-- springdoc-openapi：生成 OpenAPI 3 文档，并提供 Swagger UI（Spring Boot 4 对应的版本） -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- ==================== 工具 ==================== -->

    <!-- Lombok：用注解生成 getter/setter/构造器，只在编译期生效，不会打进最终 jar -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ==================== 测试 ==================== -->

    <!-- 测试基础套件：JUnit 6、Mockito、AssertJ、Spring Test、JSON 断言等 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- H2 内存数据库：测试使用，避免依赖本机 MySQL -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 把项目打成可执行的 Spring Boot fat jar（java -jar 直接启动） -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- 编译插件：配置注解处理器白名单 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <!-- 白名单内只有 Lombok 一个编译期处理器：javac 只从这里加载处理器，不再扫描 classpath -->
            <!-- 注意：以后引入其他"编译期生成代码"的框架（如 MapStruct、configuration-processor），
                 必须在这里追加 <path> 条目，否则编译不会执行其处理器，报错多为 ClassNotFound/缺生成类 -->
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
